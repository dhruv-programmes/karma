{
  "expo": {
    "name": "Carbon Loop",
    "slug": "carbon-loop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "carbonloop",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Carbon Loop to access motion activity so it can track steps and award walking points."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Carbon Loop to scan products and photograph receipts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Carbon Loop to show nearby recycling and repair locations."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carbonloop.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan products and photograph receipts for circular decisions.",
        "NSMotionUsageDescription": "Allow Carbon Loop to read motion activity so it can count steps and award walking points.",
        "NSLocationWhenInUseUsageDescription": "Allow Carbon Loop to show nearby recycling and repair locations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4FAF6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "ACTIVITY_RECOGNITION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.carbonloop.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81e0c211-e91e-490c-acfe-ab8dd3b4cdcc"
      }
    },
    "owner": "pranshulsoni"
  }
}
